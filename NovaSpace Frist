<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>NovaSpace | Diseños para creadores</title>

  <meta name="description" content="NovaSpace - Thumbnails y diseños para creadores, Roblox y gaming.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at 20% 20%, rgba(100, 70, 255, 0.18), transparent 30%),
        radial-gradient(circle at 80% 10%, rgba(0, 200, 255, 0.12), transparent 30%),
        #070812;
      color: white;
      min-height: 100vh;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* NAVBAR */

    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(7, 8, 18, 0.75);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .logo {
      font-size: 24px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .logo span {
      color: #7c5cff;
    }

    .nav-links {
      display: flex;
      gap: 25px;
      align-items: center;
    }

    .nav-links a {
      color: #c8c8d8;
      font-size: 14px;
      transition: 0.25s;
    }

    .nav-links a:hover {
      color: white;
    }

    /* HERO */

    .hero {
      min-height: 100vh;
      padding: 150px 7% 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 50px;
      position: relative;
    }

    .hero-content {
      max-width: 650px;
    }

    .badge {
      display: inline-block;
      padding: 8px 14px;
      border: 1px solid rgba(124, 92, 255, 0.45);
      background: rgba(124, 92, 255, 0.1);
      border-radius: 50px;
      color: #b9adff;
      font-size: 13px;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: clamp(48px, 8vw, 90px);
      line-height: 0.95;
      margin-bottom: 25px;
      letter-spacing: -4px;
    }

    .gradient-text {
      background: linear-gradient(90deg, #ffffff, #9b86ff, #55d9ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: #a7a7b8;
      font-size: 18px;
      line-height: 1.7;
      max-width: 560px;
      margin-bottom: 35px;
    }

    .buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 14px 23px;
      border-radius: 12px;
      font-weight: 700;
      border: 1px solid rgba(255,255,255,0.12);
      transition: 0.25s;
      cursor: pointer;
      display: inline-block;
    }

    .btn-primary {
      background: linear-gradient(135deg, #7c5cff, #4e8cff);
      box-shadow: 0 10px 35px rgba(92, 86, 255, 0.25);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 45px rgba(92, 86, 255, 0.4);
    }

    .btn-secondary {
      background: rgba(255,255,255,0.05);
    }

    .btn-secondary:hover {
      background: rgba(255,255,255,0.1);
      transform: translateY(-3px);
    }

    /* HERO VISUAL */

    .hero-visual {
      width: 360px;
      height: 360px;
      position: relative;
      flex-shrink: 0;
    }

    .planet {
      position: absolute;
      inset: 50px;
      border-radius: 50%;
      background: linear-gradient(135deg, #725cff, #162cff 60%, #00cfff);
      box-shadow:
        0 0 60px rgba(83, 91, 255, 0.55),
        0 0 130px rgba(0, 200, 255, 0.18);
      animation: float 5s ease-in-out infinite;
    }

    .ring {
      position: absolute;
      width: 430px;
      height: 120px;
      border: 2px solid rgba(132, 113, 255, 0.6);
      border-radius: 50%;
      top: 120px;
      left: -35px;
      transform: rotate(-20deg);
    }

    .ring2 {
      position: absolute;
      width: 400px;
      height: 100px;
      border: 1px solid rgba(0, 215, 255, 0.35);
      border-radius: 50%;
      top: 130px;
      left: -20px;
      transform: rotate(-20deg);
    }

    @keyframes float {
      0%,100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    /* SECTIONS */

    section {
      padding: 100px 7%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 55px;
    }

    .section-title h2 {
      font-size: 42px;
      margin-bottom: 12px;
    }

    .section-title p {
      color: #9292a4;
    }

    /* SERVICES */

    .services {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .card {
      background: linear-gradient(
        145deg,
        rgba(255,255,255,0.07),
        rgba(255,255,255,0.025)
      );
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 18px;
      padding: 27px;
      transition: 0.3s;
      backdrop-filter: blur(10px);
    }

    .card:hover {
      transform: translateY(-7px);
      border-color: rgba(124,92,255,0.5);
      box-shadow: 0 15px 45px rgba(0,0,0,0.3);
    }

    .card-icon {
      font-size: 30px;
      margin-bottom: 20px;
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      color: #9494a5;
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .price {
      color: #8f7cff;
      font-size: 22px;
      font-weight: 900;
    }

    /* PORTFOLIO */

    .portfolio {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .portfolio-item {
      aspect-ratio: 16/9;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,0.08);
      background:
        linear-gradient(135deg, rgba(124,92,255,0.25), rgba(0,190,255,0.08)),
        #111222;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
      position: relative;
    }

    .portfolio-item::before {
      content: "TU DISEÑO AQUÍ";
      font-weight: 900;
      font-size: 20px;
      color: rgba(255,255,255,0.65);
    }

    /* ORDER */

    .order-box {
      max-width: 700px;
      margin: auto;
      padding: 35px;
      border-radius: 22px;
      background: rgba(255,255,255,0.045);
      border: 1px solid rgba(255,255,255,0.1);
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: #d6d6e2;
      font-size: 14px;
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 14px;
      margin-bottom: 20px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.1);
      background: #0c0e1b;
      color: white;
      outline: none;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #7c5cff;
    }

    textarea {
      min-height: 140px;
      resize: vertical;
    }

    .skip {
      margin-top: 12px;
      width: 100%;
      text-align: center;
      display: block;
      color: #9999aa;
      cursor: pointer;
    }

    .skip:hover {
      color: white;
    }

    /* CONTACT */

    .contact-box {
      text-align: center;
      max-width: 650px;
      margin: auto;
    }

    .contact-box p {
      color: #9b9baa;
      line-height: 1.7;
      margin-bottom: 25px;
    }

    /* FOOTER */

    footer {
      padding: 35px 7%;
      text-align: center;
      border-top: 1px solid rgba(255,255,255,0.08);
      color: #737386;
      font-size: 13px;
    }

    /* MOBILE */

    @media (max-width: 900px) {

      .hero {
        flex-direction: column;
        text-align: center;
        padding-top: 130px;
      }

      .hero-content {
        margin: auto;
      }

      .hero p {
        margin-left: auto;
        margin-right: auto;
      }

      .buttons {
        justify-content: center;
      }

      .hero-visual {
        transform: scale(0.8);
      }

      .services {
        grid-template-columns: repeat(2, 1fr);
      }

      .portfolio {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {

      nav {
        padding: 15px 5%;
      }

      .nav-links {
        display: none;
      }

      section {
        padding: 75px 5%;
      }

      .hero {
        padding-left: 5%;
        padding-right: 5%;
      }

      .hero h1 {
        font-size: 55px;
      }

      .hero p {
        font-size: 16px;
      }

      .hero-visual {
        transform: scale(0.62);
        margin-top: -25px;
        margin-bottom: -45px;
      }

      .services {
        grid-template-columns: 1fr;
      }

      .section-title h2 {
        font-size: 34px;
      }

      .order-box {
        padding: 23px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->

  <nav>
    <a href="#inicio" class="logo">Nova<span>Space</span></a>

    <div class="nav-links">
      <a href="#servicios">Servicios</a>
      <a href="#portafolio">Portafolio</a>
      <a href="#pedido">Pedido</a>
      <a href="#contacto">Contacto</a>
    </div>
  </nav>

  <!-- HERO -->

  <header class="hero" id="inicio">

    <div class="hero-content">

      <div class="badge">
        🚀 Diseño para creadores
      </div>

      <h1>
        Haz que tu contenido
        <span class="gradient-text">destaque.</span>
      </h1>

      <p>
        Thumbnails y diseños para YouTube, Roblox y gaming.
        Diseños modernos, rápidos y hechos para llamar la atención.
      </p>

      <div class="buttons">

        <a href="#servicios" class="btn btn-primary">
          Ver servicios
        </a>

        <a href="#pedido" class="btn btn-secondary">
          Contactar
        </a>

      </div>

    </div>

    <div class="hero-visual">
      <div class="planet"></div>
      <div class="ring"></div>
      <div class="ring2"></div>
    </div>

  </header>


  <!-- SERVICES -->

  <section id="servicios">

    <div class="section-title">

      <h2>Servicios</h2>

      <p>
        Diseños sencillos, rápidos y accesibles.
      </p>

    </div>

    <div class="services">

      <div class="card">

        <div class="card-icon">🖼️</div>

        <h3>Thumbnail</h3>

        <p>
          Thumbnail personalizada para YouTube,
          Roblox o contenido gaming.
        </p>

        <div class="price">
          RD$150
        </div>

      </div>


      <div class="card">

        <div class="card-icon">⚡</div>

        <h3>Thumbnail Premium</h3>

        <p>
          Un diseño más trabajado para destacar
          tu contenido.
        </p>

        <div class="price">
          RD$250
        </div>

      </div>


      <div class="card">

        <div class="card-icon">🎮</div>

        <h3>Pack x3</h3>

        <p>
          Tres thumbnails personalizadas
          para tus próximos videos.
        </p>

        <div class="price">
          RD$600
        </div>

      </div>


      <div class="card">

        <div class="card-icon">✨</div>

        <h3>Icono / Banner</h3>

        <p>
          Diseños para perfiles, juegos
          y canales.
        </p>

        <div class="price">
          Desde RD$150
        </div>

      </div>

    </div>

  </section>


  <!-- PORTFOLIO -->

  <section id="portafolio">

    <div class="section-title">

      <h2>Portafolio</h2>

      <p>
        Algunos ejemplos de nuestro trabajo.
      </p>

    </div>

    <div class="portfolio">

      <div class="portfolio-item"></div>

      <div class="portfolio-item"></div>

      <div class="portfolio-item"></div>

    </div>

  </section>


  <!-- ORDER -->

  <section id="pedido">

    <div class="section-title">

      <h2>Haz tu pedido</h2>

      <p>
        Cuéntanos qué necesitas y nos pondremos en contacto.
      </p>

    </div>


    <div class="order-box">

      <form id="orderForm">

        <label>
          Nombre
        </label>

        <input
          type="text"
          id="name"
          placeholder="Tu nombre"
          required
        >


        <label>
          Servicio
        </label>

        <select id="service" required>

          <option value="">
            Selecciona un servicio
          </option>

          <option>
            Thumbnail - RD$150
          </option>

          <option>
            Thumbnail Premium - RD$250
          </option>

          <option>
            Pack x3 - RD$600
          </option>

          <option>
            Icono / Banner - Desde RD$150
          </option>

        </select>


        <label>
          Describe lo que necesitas
        </label>

        <textarea
          id="description"
          placeholder="Ejemplo: Quiero una thumbnail de Roblox con mi personaje y el texto..."
          required
        ></textarea>


        <button
          type="submit"
          class="btn btn-primary"
          style="width:100%;"
        >
          Enviar pedido
        </button>

      </form>


      <a
        href="#contacto"
        class="skip"
      >
        Skip → Contactar directamente
      </a>

    </div>

  </section>


  <!-- CONTACT -->

  <section id="contacto">

    <div class="contact-box">

      <div class="section-title">

        <h2>Contacta con NovaSpace</h2>

        <p>
          ¿Tienes una idea? Cuéntanos qué necesitas.
        </p>

      </div>

      <!-- CAMBIAREMOS ESTE LINK POR TU DISCORD -->

      <a
        href="#"
        class="btn btn-primary"
        id="discordButton"
      >
        💬 Contactar por Discord
      </a>

    </div>

  </section>


  <!-- FOOTER -->

  <footer>

    © 2026 NovaSpace — Diseño para creadores.

  </footer>


  <script>

    /*
      NOVASPACE V1

      Aquí conectaremos el formulario
      y Discord cuando tengamos tu enlace.
    */

    const form = document.getElementById("orderForm");

    form.addEventListener("submit", function(event) {

      event.preventDefault();

      const name =
        document.getElementById("name").value;

      const service =
        document.getElementById("service").value;

      const description =
        document.getElementById("description").value;

      alert(
        "¡Pedido preparado!\\n\\n" +
        "Nombre: " + name + "\\n" +
        "Servicio: " + service + "\\n\\n" +
        "Descripción:\\n" + description +
        "\\n\\nPróximamente conectaremos este formulario con Discord."
      );

    });


    /*
      BOTÓN DE DISCORD

      Cuando tengas tu enlace de Discord,
      cambia el "#" de href por tu enlace.

      Ejemplo:

      href="https://discord.gg/TUINVITACION"
    */

  </script>

</body>
</html>
